{
  "name": "quorum-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/export.mjs prepare && vite build && node scripts/export.mjs finalize",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "verify:export": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@rainbow-me/rainbowkit": "2.2.8",
    "@tanstack/react-query": "5.90.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "viem": "2.38.0",
    "wagmi": "2.17.0"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "typescript": "5.9.2",
    "vite": "7.1.7"
  }
}
